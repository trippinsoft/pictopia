# Direct StoreKit / Play Billing needs no RevenueCat or client store-secret keys.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Amplitude project API key (public ingestion key, never a secret key).
# Leave empty to disable analytics. Use a separate project key for preview if desired.
EXPO_PUBLIC_AMPLITUDE_API_KEY=
EXPO_PUBLIC_AMPLITUDE_SERVER_ZONE=US
# Existing Pictopia project; publishable key only, never a secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://hvacjgfjmzxxirjxhkgl.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Native bundle/package ID is fixed in app.config.js: com.trippinsoft.pictopia.
